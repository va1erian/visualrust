fn main() {
    win := ui_window("VisualRust hello window", 480, 320)
    root := ui_free(480, 320)
    greeting := ui_label("Hello, window!", 12, 12, 320, 28)
    ui_add(root, greeting)
    ui_anchor(greeting, "top_left")
    subtitle := ui_label("Built from Dyon and xui", 12, 48, 320, 28)
    ui_add(root, subtitle)
    ui_anchor(subtitle, "top_left")
    ui_run(win, root)
}
