#include <winres.h>

// Common Controls v6 + per-monitor-v2 DPI for vr-runtime's test binaries. The
// hello-window sample creates win32ui controls through the Dyon `ui_*` bindings,
// which need the v6 manifest just as win32ui's own tests do; without it
// `InitCommonControlsEx` fails and no control can be created.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "vr-runtime.manifest"
